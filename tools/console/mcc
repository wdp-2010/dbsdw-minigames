#!/bin/sh
# Run console commands on a test server through the Wings API on node1 and print the console
# lines they produced. Test servers only (default: server 5, DBSDW Minigames); never live.
#
#   tools/console/mcc "list" "tp PackShooter 120 -60 0"     one or more commands, in order
#   MCC_WAIT=3 tools/console/mcc "mg arena list"            wait longer for slow output (default 1.2 s)
#   MCC_SERVER=<uuid> tools/console/mcc ...                 another test server
#   tools/console/mcc --log 40                              just the last 40 console lines
#
# The Wings token is read on node1 from /etc/pterodactyl/config.yml and never leaves it.
set -eu
SERVER="${MCC_SERVER:-7512ee6f-f994-417f-8945-47967bd4ca25}"
WAIT="${MCC_WAIT:-1.2}"
KEY="${MCC_KEY:-$HOME/.ssh/wings-node_ed25519}"
case "$SERVER" in
  b69a7f63*) echo "mcc: refusing the live server" >&2; exit 2 ;;
esac
# Commands go over stdin as JSON so quoting survives ssh.
python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "$@" |
ssh -i "$KEY" -o BatchMode=yes root@62.83.125.228 "python3 -c '$(cat <<'PY'
import json, re, sys, time, urllib.request
server, wait = sys.argv[1], float(sys.argv[2])
args = json.loads(sys.stdin.read())
cfg = open("/etc/pterodactyl/config.yml").read().splitlines()
token = next(l.split(":", 1)[1].strip().strip("\"") for l in cfg if l.startswith("token:"))
base = f"https://node1.dbsdw.com:8080/api/servers/{server}"
def call(path, body=None):
    req = urllib.request.Request(base + path, data=None if body is None else json.dumps(body).encode(),
                                 headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"},
                                 method="GET" if body is None else "POST")
    with urllib.request.urlopen(req, timeout=10) as r:
        raw = r.read()
        return json.loads(raw) if raw else None
def logs(n):
    return call(f"/logs?size={n}")["data"]
if args[:1] == ["--log"]:
    print("\n".join(logs(int(args[1]) if len(args) > 1 else 30)))
    sys.exit(0)
before = logs(400)
for cmd in args:
    call("/commands", {"commands": [cmd]})
    time.sleep(0.15)
time.sleep(wait)
after = logs(400)
# new lines = the tail of "after" that does not overlap the tail of "before"
k = 0
for n in range(min(len(before), len(after)), 0, -1):
    if after[:n] == before[-n:]:
        k = n
        break
for line in after[k:]:
    print(re.sub(r"\x1b\[[0-9;]*m", "", line))
PY
)' $SERVER $WAIT"
